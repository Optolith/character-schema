{
  "name": "@optolith/character-schema",
  "version": "0.3.1",
  "description": "Definitions for the characters of Optolith, a character creation tool for the Pen and Paper RPG “The Dark Eye 5”.",
  "files": [
    "gen",
    "lib",
    "schema",
    "types",
    "AUTHORS",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "release:major": "npm version major -m \"build(release): v%s\"",
    "release:major:sign": "npm version major --sign-git-tag -m \"build(release): v%s\"",
    "release:minor": "npm version minor -m \"build(release): v%s\"",
    "release:minor:sign": "npm version minor --sign-git-tag -m \"build(release): v%s\"",
    "release:patch": "npm version patch -m \"build(release): v%s\"",
    "release:patch:sign": "npm version patch --sign-git-tag -m \"build(release): v%s\""
  },
  "exports": {
    "./types": {
      "types": "./types/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Optolith/character-schema.git"
  },
  "author": "Lukas Obermann",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/Optolith/character-schema/issues"
  },
  "homepage": "https://github.com/Optolith/character-schema#readme",
  "devDependencies": {
    "@elyukai/oxc-config": "^0.1.5",
    "@elyukai/utils": "^0.3.13",
    "@optolith/database-schema": "^0.118.0",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
